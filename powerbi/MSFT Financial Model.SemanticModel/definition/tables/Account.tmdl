/// Income statement lines as reported. Sign: +1 adds to profit, −1 reduces it.
table Account
	lineageTag: d2ae1589-1a05-5f98-a31c-b3a23d62c3c8

	column AccountKey
		dataType: int64
		isHidden
		lineageTag: 75d23d64-5083-53fd-affa-e0a27f43f570
		summarizeBy: none
		sourceColumn: AccountKey

		annotation SummarizationSetBy = Automatic

	column Code
		dataType: string
		lineageTag: 76b2fef6-b4eb-527f-8a56-15b8838fabaa
		summarizeBy: none
		sourceColumn: Code

		annotation SummarizationSetBy = Automatic

	column Account
