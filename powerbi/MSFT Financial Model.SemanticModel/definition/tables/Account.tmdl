	partition Account = m
		mode: import
		source =
				let
				    Source = LoadCsv("dim_account.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"AccountKey", Int64.Type}, {"Code", type text}, {"Account", type text}, {"Line Group", type text}, {"Sign", Int64.Type}, {"Sort", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
