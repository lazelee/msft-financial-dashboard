/// Per-share, cash-flow and Microsoft Cloud metrics. $M except EPS ($) and shares (M).
table 'Financial Metrics'
	lineageTag: 0429bfa3-bb82-5d0a-9336-d15db4a778da

	column PeriodKey
		dataType: int64
		isHidden
		lineageTag: 73bb46b8-eac1-50d9-b1b2-22b50913986a
		summarizeBy: none
		sourceColumn: PeriodKey

		annotation SummarizationSetBy = Automatic

	column VersionKey
		dataType: int64
		isHidden
		lineageTag: a62f1edf-a0b6-5066-bb00-764134637c16
		summarizeBy: none
		sourceColumn: VersionKey

		annotation SummarizationSetBy = Automatic

	column Metric
		dataType: string
		lineageTag: 2df2fa6c-863f-5c41-8e43-92860296a86e
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = Automatic

	column Value
		dataType: double
		formatString: #,##0.00
		isHidden
		lineageTag: d56151df-a86d-5ef7-8b21-86f3d1f5afc1
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition 'Financial Metrics' = m
		mode: import
		source =
				let
				    Source = LoadCsv("fact_kpi.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"PeriodKey", Int64.Type}, {"VersionKey", Int64.Type}, {"Metric", type text}, {"Value", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
