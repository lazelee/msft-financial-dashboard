/// All model measures, grouped in display folders.
table _Measures
	lineageTag: a06cccf6-df7e-50e2-9c41-24724838f3c4

	/// Scenario picked in the slicer; Base when none or several are selected.
	measure 'Selected Scenario' = SELECTEDVALUE ( 'Scenario'[Scenario], "Base" )
		displayFolder: Engine
		lineageTag: 71c550b6-a34a-5b14-9d9a-c0fef12ea5d7

	/// Latest fiscal year with reported results.
	measure 'Last Actual FY' = CALCULATE ( MAX ( 'Period'[Fiscal Year] ), REMOVEFILTERS ( 'Period' ), 'Period'[Is Forecast] = FALSE () )
		formatString: 0
		displayFolder: Engine
		lineageTag: 4e65bb4e-07cb-5a46-bf88-bbb5c256139b

	/// Actuals where reported, otherwise the selected scenario. If a visual filters Version (e.g. Plan), that version is used as is.
	measure _Amount =
			VAR _scenario = [Selected Scenario]
			RETURN
			    IF (
			        ISFILTERED ( 'Version' ),
			        SUM ( 'P&L'[Amount] ),
			        VAR _actual = CALCULATE ( SUM ( 'P&L'[Amount] ), 'Version'[Version Type] = "Actual" )
			        RETURN IF ( NOT ISBLANK ( _actual ), _actual, CALCULATE ( SUM ( 'P&L'[Amount] ), 'Version'[Scenario] = _scenario ) )
			    )
		formatString: #,##0;(#,##0)
		isHidden
		displayFolder: Engine
		lineageTag: 5028014a-bd0e-56b6-b578-415b12462c15

	/// 1 for forecast periods (where flex parameters apply).
	measure '_Is Forecast' = IF ( MAX ( 'Period'[Years From Last Actual] ) > 0 && NOT ISFILTERED ( 'Version' ), 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Engine
		lineageTag: 54c6f8a7-3a36-5a16-8d99-8e3b992e890c

	/// What-if: extra revenue growth per forecast year (compounding), cost of revenue moves with it.
	measure 'Revenue Flex Value' = SELECTEDVALUE ( 'Revenue Growth Flex'[Revenue Growth Flex], 0 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Engine
		lineageTag: 12c5dedc-517c-5de4-bf07-46dbd70c9d07

	/// What-if: change to operating expenses in forecast years (costs don't flex with revenue: operating leverage).
	measure 'Opex Flex Value' = SELECTEDVALUE ( 'Opex Flex'[Opex Flex], 0 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Engine
		lineageTag: 46b76195-a4f7-5d63-9831-81e7a312b5f3

	/// Multiplier applied to forecast revenue and cost of revenue.
	measure '_Revenue Factor' = IF ( [_Is Forecast] = 1, POWER ( 1 + [Revenue Flex Value], MAX ( 'Period'[Years From Last Actual] ) ), 1 )
		formatString: 0.000
		isHidden
		displayFolder: Engine
		lineageTag: ad615d6b-1d45-555e-9f2a-be226acb065d

	/// Multiplier applied to forecast opex.
	measure '_Opex Factor' = IF ( [_Is Forecast] = 1, 1 + [Opex Flex Value], 1 )
		formatString: 0.000
		isHidden
		displayFolder: Engine
		lineageTag: 74a0652c-8b3e-5a02-aa65-81ea278b2b6b

	/// Effective tax rate of the underlying (unflexed) numbers; applied to flexed pretax income.
	measure '_Base Tax Rate' = DIVIDE ( CALCULATE ( [_Amount], 'Account'[Code] = "TAX" ), CALCULATE ( [_Amount], 'Account'[Code] = "REV" ) - CALCULATE ( [_Amount], 'Account'[Code] = "COGS" ) - CALCULATE ( [_Amount], 'Account'[Line Group] = "Operating expenses" ) + CALCULATE ( [_Amount], 'Account'[Code] = "OIE" ) )
		formatString: 0.0%;-0.0%
		isHidden
		displayFolder: Engine
		lineageTag: fb3bc4b6-b191-552e-9c7b-5d55b6130480

	/// Revenue, $M.
	measure Revenue = CALCULATE ( [_Amount], 'Account'[Code] = "REV" ) * [_Revenue Factor]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 44bbaa3d-7fd5-5e91-a8f2-ee3a9ef69c92

	/// Cost of revenue, $M (positive).
	measure 'Cost of Revenue' = CALCULATE ( [_Amount], 'Account'[Code] = "COGS" ) * [_Revenue Factor]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: a0e0dccb-36db-5901-9ecd-b4aad3a3a004

	/// Revenue − cost of revenue.
	measure 'Gross Profit' = [Revenue] - [Cost of Revenue]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: ac5a6e02-b5a4-5662-ae5c-0eb7dedc7838

	measure 'Research and Development' = CALCULATE ( [_Amount], 'Account'[Code] = "RD" ) * [_Opex Factor]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: bd068fa6-1b5f-515b-ae50-52ecfea8f994

	measure 'Sales and Marketing' = CALCULATE ( [_Amount], 'Account'[Code] = "SM" ) * [_Opex Factor]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: fc736b49-4fd5-54db-89bf-0de9cdacf61f

	measure 'General and Administrative' = CALCULATE ( [_Amount], 'Account'[Code] = "GA" ) * [_Opex Factor]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: ac2264a1-5f50-5e48-84e1-f8cca3e19a24

	/// Impairment, integration and restructuring (FY2012 aQuantive, FY2015–17 Nokia).
	measure 'Impairment and Restructuring' = CALCULATE ( [_Amount], 'Account'[Code] = "IMP" )
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 5f302232-a6f9-5502-b257-cbb3792b30b4

	/// Total operating expenses.
	measure 'Operating Expenses' = [Research and Development] + [Sales and Marketing] + [General and Administrative] + [Impairment and Restructuring]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 3e044257-04df-56f2-9340-6c004eba270f

	/// Gross profit − operating expenses.
	measure 'Operating Income' = [Gross Profit] - [Operating Expenses]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 92b06394-8239-5042-8265-996d6e132986

	/// Other income (expense), net; keeps its reported sign.
	measure 'Other Income (Expense)' = CALCULATE ( [_Amount], 'Account'[Code] = "OIE" )
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 6d5b935f-3e04-5b42-9ff8-966efcb7c8be

	/// Income before income taxes.
	measure 'Pretax Income' = [Operating Income] + [Other Income (Expense)]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 560e3193-d262-5d7b-bb8c-10e4d245a5de

	/// Provision for income taxes; in forecasts, the scenario's tax rate on (flexed) pretax income.
	measure 'Income Tax' = IF ( [_Is Forecast] = 1, [Pretax Income] * [_Base Tax Rate], CALCULATE ( [_Amount], 'Account'[Code] = "TAX" ) )
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: 3bb891d5-f53a-5fef-9f4e-e098c18fb27d

	/// Net income, $M.
	measure 'Net Income' = [Pretax Income] - [Income Tax]
		formatString: #,##0;(#,##0)
		displayFolder: Income statement
		lineageTag: d290c19c-ef36-59ba-b9f2-44b610fc2448

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: 0381ad8e-adda-5f02-afb7-c96c42979b95

	measure 'Opex % of Revenue' = DIVIDE ( [Operating Expenses], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: adc5ec33-8f09-53f6-a1ce-1d09115c0177

	measure 'R&D % of Revenue' = DIVIDE ( [Research and Development], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: 92f15c07-9acf-5b61-96b1-1e6180f91ef3

	measure 'Operating Margin %' = DIVIDE ( [Operating Income], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: 0327c989-bba3-54a5-87d4-f8605df3b3ea

	measure 'Effective Tax Rate' = DIVIDE ( [Income Tax], [Pretax Income] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: 2515a289-a510-55d4-a295-76e97dfaa5d0

	measure 'Net Margin %' = DIVIDE ( [Net Income], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Ratios
		lineageTag: 9322b6be-7273-57b4-8912-94b996f8b316

	/// KPI value with the same actual-else-scenario logic as _Amount.
	measure _KPI =
			VAR _scenario = [Selected Scenario]
			VAR _actual = CALCULATE ( SUM ( 'Financial Metrics'[Value] ), 'Version'[Version Type] = "Actual" )
			RETURN
			    IF (
			        ISFILTERED ( 'Version' ),
			        SUM ( 'Financial Metrics'[Value] ),
			        IF ( NOT ISBLANK ( _actual ), _actual, CALCULATE ( SUM ( 'Financial Metrics'[Value] ), 'Version'[Scenario] = _scenario ) )
			    )
		formatString: #,##0.00
		isHidden
		displayFolder: Engine
		lineageTag: e2134da6-f608-5f40-b354-b79bc86aafd2

	/// Weighted average diluted shares, millions.
	measure 'Diluted Shares (M)' = CALCULATE ( [_KPI], 'Financial Metrics'[Metric] = "Diluted shares (M)" )
		formatString: #,##0
		displayFolder: Per share and cash
		lineageTag: 22a3cacc-08de-5827-8f5e-b88cc90c9df5

	/// Net income ÷ diluted shares (matches reported EPS within rounding).
	measure 'Diluted EPS' = DIVIDE ( [Net Income], [Diluted Shares (M)] )
		formatString: $0.00;($0.00)
		displayFolder: Per share and cash
		lineageTag: 19000672-5c96-52f7-84a7-d122bfec2d7e

	measure 'Operating Cash Flow' = CALCULATE ( [_KPI], 'Financial Metrics'[Metric] = "Operating cash flow" )
		formatString: #,##0;(#,##0)
		displayFolder: Per share and cash
		lineageTag: 22cd0a6f-78e8-51f0-8377-2baae921997e

	/// Additions to property and equipment.
	measure 'Capital Expenditures' = CALCULATE ( [_KPI], 'Financial Metrics'[Metric] = "Capital expenditures" )
		formatString: #,##0;(#,##0)
		displayFolder: Per share and cash
		lineageTag: 7e30d438-a53a-5d31-b098-d9fc88626ae6

	measure 'Free Cash Flow' = [Operating Cash Flow] - [Capital Expenditures]
		formatString: #,##0;(#,##0)
		displayFolder: Per share and cash
		lineageTag: 99c319ef-d611-5904-9f77-b474319490e7

	measure 'Capex % of Revenue' = DIVIDE ( [Capital Expenditures], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Per share and cash
		lineageTag: b33df827-6fe2-5c11-b788-fbc1d5019d97

	measure 'FCF Margin %' = DIVIDE ( [Free Cash Flow], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Per share and cash
		lineageTag: 577865a0-3315-5c53-b158-079616d37fb3

	/// Microsoft Cloud (overlaps segments; not additive with them).
	measure 'Microsoft Cloud Revenue' = CALCULATE ( [_KPI], 'Financial Metrics'[Metric] = "Microsoft Cloud revenue" )
		formatString: #,##0;(#,##0)
		displayFolder: Per share and cash
		lineageTag: 66529c92-e5da-5eac-9283-103e334a6623

	measure 'Microsoft Cloud % of Revenue' = DIVIDE ( [Microsoft Cloud Revenue], [Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Per share and cash
		lineageTag: 41bb13e2-ff71-5107-8d16-bef13720d64e

	/// Revenue in the same period a year earlier.
	measure 'Revenue PY' = VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] ) RETURN CALCULATE ( [Revenue], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 )
		formatString: #,##0;(#,##0)
		displayFolder: Growth
		lineageTag: f2a31d6f-e9cc-544f-88ba-7d93cf6d0b5f

	measure 'Revenue YoY %' = DIVIDE ( [Revenue], [Revenue PY] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Growth
		lineageTag: 4cbacefe-8ad9-5eb7-a37e-dd95215caf8d

	measure 'Operating Income YoY %' = VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] ) RETURN DIVIDE ( [Operating Income], CALCULATE ( [Operating Income], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 ) ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Growth
		lineageTag: 0a7b34c0-27a1-5c64-8151-0b3173cd6b59

	measure 'Diluted EPS YoY %' = VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] ) RETURN DIVIDE ( [Diluted EPS], CALCULATE ( [Diluted EPS], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 ) ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Growth
		lineageTag: 9a0c4478-877f-50ca-838d-513d09a3d24d

	/// Last actual fiscal year revenue.
	measure 'LY Revenue' = VAR _fy = [Last Actual FY] RETURN CALCULATE ( [Revenue], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: #,##0;(#,##0)
		displayFolder: Headline
		lineageTag: 4b50be1b-efae-5a9b-baf2-39b87ae83b4a

	measure 'LY Revenue YoY %' = VAR _fy = [Last Actual FY] RETURN CALCULATE ( [Revenue YoY %], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Headline
		lineageTag: 3e104660-df83-5a90-92dd-f5df7c5d2ccf

	measure 'LY Operating Margin %' = VAR _fy = [Last Actual FY] RETURN CALCULATE ( [Operating Margin %], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: 0.0%;-0.0%
		displayFolder: Headline
		lineageTag: 2ec73b19-fc10-5310-a171-857fe858c81e

	measure 'LY Diluted EPS' = VAR _fy = [Last Actual FY] RETURN CALCULATE ( [Diluted EPS], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: $0.00;($0.00)
		displayFolder: Headline
		lineageTag: 61e542e2-cb42-5d30-b9e8-ae7b818f34b2

	measure 'LY Free Cash Flow' = VAR _fy = [Last Actual FY] RETURN CALCULATE ( [Free Cash Flow], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: #,##0;(#,##0)
		displayFolder: Headline
		lineageTag: 5f9bcb21-8906-5f4b-9e8a-a59cc3c858f0

	/// Next fiscal year revenue, selected scenario.
	measure 'NY Revenue' = VAR _fy = [Last Actual FY] + 1 RETURN CALCULATE ( [Revenue], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: #,##0;(#,##0)
		displayFolder: Headline
		lineageTag: 8584fa41-7ebf-50e8-a192-9afa79d07add

	measure 'NY Revenue YoY %' = VAR _fy = [Last Actual FY] + 1 RETURN CALCULATE ( [Revenue YoY %], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Headline
		lineageTag: 5202e8ae-fc04-5eaa-9b6d-9e0ef83c56b0

	measure 'NY Operating Margin %' = VAR _fy = [Last Actual FY] + 1 RETURN CALCULATE ( [Operating Margin %], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: 0.0%;-0.0%
		displayFolder: Headline
		lineageTag: 0c2bf7b4-e421-5587-b98a-d7b857e3ca05

	/// Next fiscal year diluted EPS, selected scenario (with flex).
	measure 'NY Diluted EPS' = VAR _fy = [Last Actual FY] + 1 RETURN CALCULATE ( [Diluted EPS], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: $0.00;($0.00)
		displayFolder: Headline
		lineageTag: ecce56b5-bfa7-5379-b7f8-3de0d4edc3e2

	measure 'NY Diluted EPS YoY %' = VAR _fy = [Last Actual FY] + 1 RETURN CALCULATE ( [Diluted EPS YoY %], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Headline
		lineageTag: 86d51ff1-9e8a-5960-8ec4-d8bf5cd7e4fc

	/// Diluted EPS three years out, selected scenario.
	measure 'Y3 Diluted EPS' = VAR _fy = [Last Actual FY] + 3 RETURN CALCULATE ( [Diluted EPS], REMOVEFILTERS ( 'Period' ), 'Period'[Fiscal Year] = _fy, 'Period'[Period Type] = "Year" )
		formatString: $0.00;($0.00)
		displayFolder: Headline
		lineageTag: d9a33545-2a87-5f91-8424-d5a032c1c96b

	measure 'EPS CAGR (3y)' = DIVIDE ( [Y3 Diluted EPS], [LY Diluted EPS] ) ^ ( 1 / 3 ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Headline
		lineageTag: 144cb7bd-f5d7-5585-8050-7bf98d004f30

	/// Next-year EPS weighted by scenario probabilities (assumptions file).
	measure 'NY Diluted EPS (Probability-Weighted)' =
			SUMX (
			    ALL ( 'Scenario' ),
			    'Scenario'[Probability] * CALCULATE ( [NY Diluted EPS] )
			)
		formatString: $0.00;($0.00)
		displayFolder: Headline
		lineageTag: 64a50d9e-bfb4-5909-a54e-81612fa4a5b1

	/// Segment amount with the actual-else-scenario logic.
	measure '_Segment Amount' =
			VAR _scenario = [Selected Scenario]
			VAR _actual = CALCULATE ( SUM ( 'Segment P&L'[Amount] ), 'Version'[Version Type] = "Actual" )
			RETURN
			    IF (
			        ISFILTERED ( 'Version' ),
			        SUM ( 'Segment P&L'[Amount] ),
			        IF ( NOT ISBLANK ( _actual ), _actual, CALCULATE ( SUM ( 'Segment P&L'[Amount] ), 'Version'[Scenario] = _scenario ) )
			    )
		formatString: #,##0;(#,##0)
		isHidden
		displayFolder: Engine
		lineageTag: e1865c08-7b22-5ff5-81e6-0d4e8e6f1de0

	measure 'Segment Revenue' = CALCULATE ( [_Segment Amount], 'Segment P&L'[Metric] = "Revenue" )
		formatString: #,##0;(#,##0)
		displayFolder: Segments
		lineageTag: ee9db62b-1f38-5982-b682-37e548d4d9ad

	measure 'Segment Operating Income' = CALCULATE ( [_Segment Amount], 'Segment P&L'[Metric] = "Operating income" )
		formatString: #,##0;(#,##0)
		displayFolder: Segments
		lineageTag: 22f9b57a-ae1b-53dc-af4e-423132694a56

	/// Available from FY2023 annual and FY2025 quarterly (segment costs disclosed from FY2025).
	measure 'Segment Gross Margin %' = DIVIDE ( [Segment Revenue] - CALCULATE ( [_Segment Amount], 'Segment P&L'[Metric] = "Cost of revenue" ), [Segment Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Segments
		lineageTag: 9e2d86ee-c9fc-50c2-95b5-6a0de5466492

	measure 'Segment Operating Margin %' = DIVIDE ( [Segment Operating Income], [Segment Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: Segments
		lineageTag: 35115e0f-04c1-50af-bf70-55ae57cb4a99

	measure 'Segment Revenue YoY %' = VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] ) RETURN DIVIDE ( [Segment Revenue], CALCULATE ( [Segment Revenue], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 ) ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Segments
		lineageTag: 73e8e990-7e91-504d-9c3a-416617341f02

	measure 'Segment Revenue Share %' = DIVIDE ( [Segment Revenue], CALCULATE ( [Segment Revenue], REMOVEFILTERS ( 'Segment' ) ) )
		formatString: 0.0%;-0.0%
		displayFolder: Segments
		lineageTag: a97a4f0f-0a40-5723-bfb1-463e3eea45f5

	/// Revenue by the breakdown on the visual (actuals).
	measure 'Mix Revenue' = SUM ( 'Revenue Mix'[Amount] )
		formatString: #,##0;(#,##0)
		displayFolder: Revenue mix
		lineageTag: 586de13e-1867-55a3-b8bc-5417388cb3c9

	measure 'Mix Revenue YoY %' = VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] ) RETURN DIVIDE ( [Mix Revenue], CALCULATE ( [Mix Revenue], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 ) ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Revenue mix
		lineageTag: 824978fe-9ec6-5843-af00-98f5ada18cdd

	measure 'Mix Share %' = DIVIDE ( [Mix Revenue], CALCULATE ( [Mix Revenue], REMOVEFILTERS ( 'Revenue Mix'[Item] ) ) )
		formatString: 0.0%;-0.0%
		displayFolder: Revenue mix
		lineageTag: e5a4cb35-306c-5650-b676-1c0500a25ad7

	/// Value for the P&L Line on the row; costs shown negative. Formatting follows the line ($M, %, $/share).
	measure 'P&L Value' =
			VAR _line = SELECTEDVALUE ( 'P&L Line'[Line] )
			RETURN
			    SWITCH (
			        _line,
			        "Revenue", [Revenue],
			        "Cost of revenue", - [Cost of Revenue],
			        "Gross profit", [Gross Profit],
			        "Gross margin %", [Gross Margin %],
			        "Research and development", - [Research and Development],
			        "Sales and marketing", - [Sales and Marketing],
			        "General and administrative", - [General and Administrative],
			        "Impairment and restructuring", IF ( [Impairment and Restructuring] <> 0, - [Impairment and Restructuring] ),
			        "Total operating expenses", - [Operating Expenses],
			        "Opex % of revenue", [Opex % of Revenue],
			        "Operating income", [Operating Income],
			        "Operating margin %", [Operating Margin %],
			        "Other income (expense), net", [Other Income (Expense)],
			        "Income before income taxes", [Pretax Income],
			        "Provision for income taxes", - [Income Tax],
			        "Effective tax rate", [Effective Tax Rate],
			        "Net income", [Net Income],
			        "Net margin %", [Net Margin %],
			        "Diluted shares (M)", [Diluted Shares (M)],
			        "Diluted EPS", [Diluted EPS]
			    )
		displayFolder: P&L template
		lineageTag: ef510425-204c-5d46-be8a-9d060acbe349

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'P&L Line'[Format] ),
				    "P", "0.0%;-0.0%",
				    "E", "$0.00;($0.00)",
				    "S", "#,##0",
				    "#,##0;(#,##0)"
				)

	/// Year-over-year change: % for amounts, percentage points for ratios.
	measure 'P&L YoY' =
			VAR _k = SELECTEDVALUE ( 'Period'[PeriodKey] )
			VAR _now = [P&L Value]
			VAR _prior = CALCULATE ( [P&L Value], REMOVEFILTERS ( 'Period' ), 'Period'[PeriodKey] = _k - 10 )
			RETURN
			    IF (
			        NOT ISBLANK ( _now ) && NOT ISBLANK ( _prior ),
			        IF ( SELECTEDVALUE ( 'P&L Line'[Format] ) = "P", _now - _prior, DIVIDE ( _now - _prior, ABS ( _prior ) ) )
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: P&L template
		lineageTag: eb8696ae-dd98-5fa7-899d-da213cc2f7a7

	measure 'P&L Actual' = CALCULATE ( [P&L Value], 'Version'[Version Type] = "Actual" )
		displayFolder: P&L template
		lineageTag: 916c0372-35e2-50e0-9fa1-c767f211e34e

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'P&L Line'[Format] ),
				    "P", "0.0%;-0.0%",
				    "E", "$0.00;($0.00)",
				    "S", "#,##0",
				    "#,##0;(#,##0)"
				)

	/// What the model would have forecast a year earlier (rules applied to prior-year actuals, no hindsight).
	measure 'P&L Plan' = CALCULATE ( [P&L Value], 'Version'[Version Type] = "Plan" )
		displayFolder: P&L template
		lineageTag: bed6f14e-e3ce-507e-b42a-7405e8a4a16b

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'P&L Line'[Format] ),
				    "P", "0.0%;-0.0%",
				    "E", "$0.00;($0.00)",
				    "S", "#,##0",
				    "#,##0;(#,##0)"
				)

	/// Actual − plan (pp for ratios). Costs are negative, so a positive variance on any $ line is favourable.
	measure 'P&L Variance' = IF ( NOT ISBLANK ( [P&L Plan] ), [P&L Actual] - [P&L Plan] )
		displayFolder: P&L template
		lineageTag: e0fd06e4-80e0-51a3-88c5-5b1c6cb29f7e

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'P&L Line'[Format] ),
				    "P", "+0.0%;-0.0%",
				    "E", "+$0.00;-$0.00",
				    "S", "+#,##0;-#,##0",
				    "+#,##0;-#,##0"
				)

	measure 'P&L Variance %' =
			IF (
			    SELECTEDVALUE ( 'P&L Line'[Format] ) IN { "M", "E" },
			    DIVIDE ( [P&L Variance], ABS ( [P&L Plan] ) )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: P&L template
		lineageTag: 3f857087-1e10-5500-a88b-dcbea2d6b88c

	/// Green when the variance is favourable, red when not (lower is better for costs ratios and tax rate).
	measure 'Variance Color' =
			VAR _v = [P&L Variance] * SELECTEDVALUE ( 'P&L Line'[Favourable], 1 )
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), _v >= 0, "#1B7F3B", "#B3261E" )
		displayFolder: P&L template
		lineageTag: 165272d8-3cd6-54e8-8b54-589f581190bf

	measure 'Segment Revenue Plan' = CALCULATE ( [Segment Revenue], 'Version'[Version Type] = "Plan" )
		formatString: #,##0;(#,##0)
		displayFolder: Segments
		lineageTag: b6dc0173-f3f3-58a6-8997-ca29441c5bb6

	measure 'Segment Revenue Actual' = CALCULATE ( [Segment Revenue], 'Version'[Version Type] = "Actual" )
		formatString: #,##0;(#,##0)
		displayFolder: Segments
		lineageTag: 3d5477c8-fe70-5db2-a50f-f4fa4fc4e46f

	measure 'Segment Revenue Variance %' = DIVIDE ( [Segment Revenue Actual] - [Segment Revenue Plan], [Segment Revenue Plan] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Segments
		lineageTag: 1ec77756-47c4-56b7-b2f5-c8da1dbb9666

	measure 'Segment OM % Plan' = CALCULATE ( [Segment Operating Margin %], 'Version'[Version Type] = "Plan" )
		formatString: 0.0%;-0.0%
		displayFolder: Segments
		lineageTag: bd983373-618b-5132-951a-ba2eaab298e3

	measure 'Segment OM % Actual' = CALCULATE ( [Segment Operating Margin %], 'Version'[Version Type] = "Actual" )
		formatString: 0.0%;-0.0%
		displayFolder: Segments
		lineageTag: 2cbaaaea-fcc3-54b6-b3dd-d196b3ff7cb7

	/// Bridge step value ($M for net income / operating income, $ for EPS).
	measure 'Bridge Value' = SUM ( 'Bridge'[Value] )
		formatString: #,##0.00
		displayFolder: Bridges
		lineageTag: 7d0545e5-ab73-5f0b-8cea-e917c0dc14c3

	measure 'Sensitivity EPS' = SUM ( 'Sensitivity'[Diluted EPS ($)] )
		formatString: $0.00;($0.00)
		displayFolder: Sensitivity
		lineageTag: 7aee703b-6499-5117-8364-3e5d1df192ed

	measure 'Sensitivity vs Base' =
			VAR _base = CALCULATE ( SUM ( 'Sensitivity'[Diluted EPS ($)] ), REMOVEFILTERS ( 'Sensitivity' ), 'Sensitivity'[Revenue Growth Delta (pp)] = 0, 'Sensitivity'[Operating Margin Delta (bp)] = 0 )
			RETURN DIVIDE ( [Sensitivity EPS], _base ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Sensitivity
		lineageTag: aee9dba4-3850-5816-af92-8635b132c654

	/// Cell shading: green above base, red below.
	measure 'Sensitivity Color' =
			VAR _d = [Sensitivity vs Base]
			RETURN SWITCH ( TRUE (), _d > 0.10, "#7FC8A0", _d > 0.03, "#C9E8D5", _d >= -0.03, "#F2F2F2", _d >= -0.10, "#F5CBC7", "#E8908A" )
		displayFolder: Sensitivity
		lineageTag: 50399174-52a7-5e2a-bedf-01e1c6b93d84

	/// Mean absolute % error of the model.
	measure 'Model MAPE' = AVERAGEX ( 'Backtest', ABS ( 'Backtest'[Model Error %] ) )
		formatString: 0.0%;-0.0%
		displayFolder: Validation
		lineageTag: 432fce9b-5c9a-5a07-a87f-29da2b728d35

	/// Same, for last-year-repeats.
	measure 'Naive MAPE' = AVERAGEX ( 'Backtest', ABS ( 'Backtest'[Naive Error %] ) )
		formatString: 0.0%;-0.0%
		displayFolder: Validation
		lineageTag: 458892c2-1867-546a-84ac-c35022daff7c

	/// Average signed error: + means over-forecast.
	measure 'Model Bias' = AVERAGE ( 'Backtest'[Model Error %] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Validation
		lineageTag: a8833a5f-61c9-5161-8be1-2706d37ebfbc

	measure 'Model MAPE ex One-offs' = CALCULATE ( [Model MAPE], 'Backtest'[One-off Year] = FALSE () )
		formatString: 0.0%;-0.0%
		displayFolder: Validation
		lineageTag: f1880f33-cc8c-53e1-995c-8a39fa0b08f1

	measure 'Naive MAPE ex One-offs' = CALCULATE ( [Naive MAPE], 'Backtest'[One-off Year] = FALSE () )
		formatString: 0.0%;-0.0%
		displayFolder: Validation
		lineageTag: eb155bca-f1c3-520b-a4f8-eca54407e85f

	measure 'Checks Passed' = COUNTROWS ( FILTER ( 'Checks', 'Checks'[Status] = "Pass" ) ) + 0
		formatString: #,##0
		displayFolder: Validation
		lineageTag: 450bb710-f554-5d17-ab9a-8ae9f17ac7f2

	measure 'Checks Failed' = COUNTROWS ( FILTER ( 'Checks', 'Checks'[Status] = "Fail" ) ) + 0
		formatString: #,##0
		displayFolder: Validation
		lineageTag: 63359a8b-e341-5cc6-863b-7c35f013d7ca

	/// Driver value in its unit (%, bp or $M).
	measure 'Assumption Value' = SUM ( 'Assumptions'[Value] )
		formatString: #,##0.0
		displayFolder: Assumptions
		lineageTag: e6a61fc0-91a3-553a-a780-38fdfbe9590c

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 016aaf5e-d253-51f9-ba6d-0d42a6abe863
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", "" )

